{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // No `baseUrl`: TypeScript 6 deprecates it, and since 5.0 `paths` resolves
    // against the directory holding this file on its own. Keeping it made
    // `npm run typecheck` exit 1 before it had checked a single line.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Jest's globals reach the test files. Declared rather than picked up from
    // `node_modules/@types`, which TypeScript 6 no longer sweeps in for
    // packages that are only transitive dependencies.
    "types": ["jest", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
