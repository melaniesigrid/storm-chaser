# Open-Meteo requires no key. Kept here so the base URL can be pointed at a
# proxy or a mock server during testing.
EXPO_PUBLIC_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Cloud sync target. The client in src/services/cloud is integration code only:
# no credentials are committed and sync is disabled unless this is set.
EXPO_PUBLIC_SYNC_BASE_URL=
